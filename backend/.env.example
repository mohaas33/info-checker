# Copy to backend/.env and adjust. This file holds settings and key-file PATHS only,
# never key values. Each key file contains just the key (see the README).
# "~" is expanded. Other relative paths resolve against the project root.
# For each key set either NAME_FILE (recommended) or NAME, not both.

# Nebius Token Factory (LLM): https://tokenfactory.nebius.com
NEBIUS_API_KEY_FILE=~/.config/info_checker/key_nebius.txt
# Tavily (web search): https://app.tavily.com
TAVILY_API_KEY_FILE=~/.config/info_checker/key_tavily.txt
# Google Fact Check Tools API. Optional: leave commented out to skip that step.
# GOOGLE_FACTCHECK_API_KEY_FILE=~/.config/info_checker/key_google_factcheck.txt

# NVIDIA Nemotron models on Nebius Token Factory (list them: python scripts/list_models.py nemotron).
# Tested alternatives: deepseek-ai/DeepSeek-V4-Pro (extraction), zai-org/GLM-5.3 (verification),
# Qwen/Qwen3-235B-A22B-Instruct-2507 (either).
EXTRACTION_MODEL=nvidia/nemotron-3-super-120b-a12b
VERIFICATION_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Comma-separated. Use your extension's ID from chrome://extensions.
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
MAX_CLAIMS=8

# Optional: DEBUG logs each claim's queries, evidence and raw verdict (never keys).
# LOG_LEVEL=INFO
